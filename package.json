{
  "name": "friends-score-netlify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/prepare-local.mjs && netlify dev --offline --framework #static --dir dist --no-open --port 8888",
    "login": "netlify login",
    "deploy:preview": "netlify deploy",
    "deploy": "netlify deploy --prod",
    "preview:local": "npm run build && npm start",
    "test:e2e": "node scripts/qa.cjs && node scripts/probe-qa.cjs && node scripts/scoring-qa.cjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "netlify-cli": "27.8.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "description": "A self-hosted score board for friends with host-only editing and shared viewing.",
  "license": "MIT",
  "author": "Shuo-Jiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuo-Jiang/friends-score.git"
  },
  "bugs": {
    "url": "https://github.com/Shuo-Jiang/friends-score/issues"
  },
  "homepage": "https://github.com/Shuo-Jiang/friends-score#readme"
}
